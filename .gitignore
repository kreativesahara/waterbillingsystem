# ====================================================================
# .gitignore for Water Billing System
# Protects sensitive credentials, environment files, local configurations,
# database dumps with live customer data, and OS/editor metadata.
# ====================================================================

# --------------------------------------------------------------------
# 1. Environment & Secret Configuration Files
# --------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.env
config.local.php
local.config.php
*.local.php
credentials.php
credentials.json
secrets.php
secret*.json
auth.json
token.json
oauth-*.json

# --------------------------------------------------------------------
# 2. Payment & API Credentials (e.g., M-Pesa, SMS Gateways)
# --------------------------------------------------------------------
mpesa_config.php
sms_config.php
daraja_keys.php
africastalking_config.php

# --------------------------------------------------------------------
# 3. Security Certificates & Private Keys
# --------------------------------------------------------------------
*.key
*.pem
*.crt
*.cer
*.pfx
*.p12

# --------------------------------------------------------------------
# 4. Database Dumps & Backups (Prevent Leaking Real Tenant Data)
# --------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
backups/
backup/
# Ignore arbitrary SQL database dumps containing real customer records
dump.sql
backup.sql
*.sql.gz
*.sql.tar
# Whitelist default repository schema files
!database.sql
!waterbillingsystem.sql
!schema.sql

# --------------------------------------------------------------------
# 5. Log Files & Server Caches
# --------------------------------------------------------------------
*.log
logs/
error_log
access_log
php_errors.log
*.cache
.cache/

# --------------------------------------------------------------------
# 6. Session Files & Temporary Uploads
# --------------------------------------------------------------------
tmp/
temp/
sessions/
uploads/
storage/

# --------------------------------------------------------------------
# 7. Dependencies (Composer / NPM)
# --------------------------------------------------------------------
/vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
composer.phar

# --------------------------------------------------------------------
# 8. Operating System Metadata
# --------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# --------------------------------------------------------------------
# 9. IDE & Editor Artifacts
# --------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
